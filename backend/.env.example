# Copy this file to backend/.env (gitignored) and fill in real values.
# Anything set here overrides the matching value in config.json - see config.py's load_env().
# .env is loaded automatically by python-dotenv; nothing here needs exporting manually.

# MongoDB Atlas connection string (storage.mongodb.connection_string)
PAPERBITES_MONGODB_URI=

# Optional - defaults to "paperbites" if unset (storage.mongodb.database_name)
PAPERBITES_MONGODB_DB=

# Pexels API key, used for paper card thumbnail images (api.pexels_key)
PAPERBITES_PEXELS_KEY=

# Optional - Gemini API key for card description summarization (api.gemini_key).
# Without this, descriptions fall back to the paper's raw abstract.
PAPERBITES_GEMINI_KEY=

# Optional - requests/minute Gemini calls are paced to (api.gemini_requests_per_minute).
# Defaults to 5, matching gemini-2.5-flash's free-tier cap. Raise this if you're on a paid plan
# with a higher quota - the default otherwise makes a fetch-latest run needlessly slow.
PAPERBITES_GEMINI_RPM=

# Contact email sent to Unpaywall/OpenAlex/Crossref per their API etiquette (api.email)
PAPERBITES_EMAIL=

# Optional - free key from https://www.semanticscholar.org/product/api#api-key-form.
# Without this, Semantic Scholar's anonymous rate limit is very low and easy to exhaust
# during a fetch-latest run across all categories (api.semantic_scholar_key).
PAPERBITES_SEMANTIC_SCHOLAR_KEY=
