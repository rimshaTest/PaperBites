# Copy this file to backend/.env (gitignored) and fill in real values.
# Anything set here overrides the matching value in config.json - see config.py's load_env().
# .env is loaded automatically by python-dotenv; nothing here needs exporting manually.

# MongoDB Atlas connection string (storage.mongodb.connection_string)
PAPERBITES_MONGODB_URI=

# Optional - defaults to "paperbites" if unset (storage.mongodb.database_name)
PAPERBITES_MONGODB_DB=

# Pexels API key, used for paper card thumbnail images (api.pexels_key)
PAPERBITES_PEXELS_KEY=

# Optional - Gemini API key for card description summarization (api.gemini_key).
# Without this, descriptions fall back to the paper's raw abstract.
PAPERBITES_GEMINI_KEY=

# Optional, comma-separated - overrides paper/summarize.py's built-in model list
# (api.gemini_models). Summarization round-robins across these, moving on immediately (no
# delay) whenever one is rate-limited or invalid, so each model's own free-tier quota adds to
# the effective throughput instead of one model's cap gating the whole run.
PAPERBITES_GEMINI_MODELS=

# Optional, comma-separated - overrides the model list the experimental add-paper-by-photo
# feature uses (api.gemini_image_models). Unlike PAPERBITES_GEMINI_MODELS above, this is tried
# in fixed priority order (not round-robin) - put your strongest vision-capable model first, since
# this is a single interactive photo scan where read accuracy matters more than throughput.
# Defaults to gemini-2.5-pro, then gemini-2.5-flash, then gemini-2.5-flash-lite.
PAPERBITES_GEMINI_IMAGE_MODELS=

# Optional - overrides the embedding model used for semantic paper search (api.gemini_embedding_model).
# Computed exactly once per paper at ingestion (not on every reload), and once per search query -
# see paper/embeddings.py. Defaults to models/gemini-embedding-001. Uses PAPERBITES_GEMINI_KEY
# above, not a separate key.
PAPERBITES_GEMINI_EMBEDDING_MODEL=

# Contact email sent to Unpaywall/OpenAlex/Crossref per their API etiquette (api.email)
PAPERBITES_EMAIL=

# Optional - free key from https://www.semanticscholar.org/product/api#api-key-form.
# Without this, Semantic Scholar's anonymous rate limit is very low and easy to exhaust
# during a fetch-latest run across all categories (api.semantic_scholar_key).
PAPERBITES_SEMANTIC_SCHOLAR_KEY=

# Optional - Resend API key (https://resend.com) used to email password-reset codes
# (api.resend_key, email_sender.py). Without this, forgot-password requests still succeed (the
# response never reveals whether the email is registered) but no email actually goes out - the
# code is only logged server-side.
PAPERBITES_RESEND_KEY=

# Optional - the "from" address reset emails are sent as (api.resend_from_email). Defaults to
# Resend's shared sandbox sender, which only delivers to the email address you signed up to
# Resend with - set this to a verified sending domain's address before real users need resets.
PAPERBITES_RESEND_FROM_EMAIL=

# Optional - a Sentry project DSN (https://sentry.io) for crash/error monitoring (api.sentry_dsn,
# monitoring.py). Without this, errors just print to stdout/stderr like before - nothing breaks.
PAPERBITES_SENTRY_DSN=
